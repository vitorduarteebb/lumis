{
    "name": "lumis/erp",
    "description": "ERP web modular — base da aplicação (Fase 1)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.5",
        "phpmailer/phpmailer": "^6.9",
        "dompdf/dompdf": "^2.0",
        "respect/validation": "^2.3",
        "nesbot/carbon": "^3.0",
        "nfephp-org/sped-common": "^5.1",
        "nfephp-org/sped-nfe": "^5.1"
    },
    "require-dev": {},
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}

APP_NAME="Lumis ERP"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lumis_erp
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_NAME=lumis_session

LOG_CHANNEL=stack
LOG_LEVEL=debug

# E-mail (PHPMailer — integração futura; com MAIL_DRIVER=log o conteúdo vai para storage/logs)
MAIL_DRIVER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@lumiserp.local"
MAIL_FROM_NAME="Lumis ERP"
